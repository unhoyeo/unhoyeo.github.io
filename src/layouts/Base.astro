---
import BaseHead from '../components/BaseHead.astro';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import { LOCALE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  /** 상단 바에 표시할 현재 위치 */
  label?: string;
}

const { label, ...head } = Astro.props;
---

<!doctype html>
<html lang={LOCALE}>
  <head>
    <BaseHead {...head} />
  </head>
  <body>
    <a href="#main" class="sr-only skip-link">본문으로 건너뛰기</a>

    <Sidebar />

    <div class="shell">
      <Topbar label={label ?? head.title} />
      <main id="main">
        <div class="column">
          <slot />
        </div>
      </main>
    </div>

    <style>
      /* 사이드바는 fixed라 본문 열을 그만큼 밀어준다 */
      .shell {
        margin-left: var(--sidebar-w);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
        padding: var(--space-6) var(--space-6) var(--space-16);
      }

      .column {
        max-width: var(--measure);
        margin: 0 auto;
      }

      @media (max-width: 60rem) {
        .shell {
          margin-left: 0;
        }

        main {
          padding: var(--space-4) var(--space-4) var(--space-12);
        }
      }
    </style>
  </body>
</html>
