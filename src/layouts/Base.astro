---
import BaseHead from '../components/BaseHead.astro';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import { LOCALE } from '../consts';
import type { Crumb } from '../utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  /** 상단 바에 표시할 현재 위치 */
  label?: string;
  /** 글 페이지의 노션식 경로 표시. 주면 label 대신 이게 나간다 */
  crumbs?: Crumb[];
}

const { label, crumbs, ...head } = Astro.props;

/*
 * 목차를 넘긴 페이지에서만 우측 레일을 만든다. 슬롯이 비었는데 레일이 있으면
 * 빈 폭이 자리를 차지해 본문이 왼쪽으로 밀린다 — 서버에서 미리 판정해 아예 안 그린다.
 *
 * has()만으로는 부족하다. 페이지가 `{조건 && <TableOfContents slot="toc" />}`처럼
 * 넘기면 조건이 거짓이어도 has()는 true다(슬롯 자체는 존재하므로).
 * 그래서 실제로 렌더해보고 결과가 비었는지까지 확인한다.
 */
const tocHtml = Astro.slots.has('toc') ? await Astro.slots.render('toc') : '';
const hasToc = tocHtml.trim() !== '';

/*
 * 글 헤더(제목·날짜·태그)를 따로 받는 이유는 목차 레일의 시작 높이 때문이다.
 * 헤더를 별도 행에 두고 레일을 2행에 배치하면, 헤더가 몇 줄이든
 * 레일 상단이 본문 첫 줄과 자동으로 맞는다(오프셋 하드코딩 없이).
 */
const headerHtml = Astro.slots.has('post-header') ? await Astro.slots.render('post-header') : '';
const hasHeader = headerHtml.trim() !== '';
---

<!doctype html>
<html lang={LOCALE}>
  <head>
    <BaseHead {...head} />
  </head>
  <body>
    <a href="#main" class="sr-only skip-link">본문으로 건너뛰기</a>

    <Sidebar />

    <div class="shell">
      <Topbar label={label ?? head.title} crumbs={crumbs} />
      {/*
        목차 레일은 목차가 없어도 자리를 지킨다. 있을 때만 만들면 본문 열이
        페이지마다 좌우로 움직여서, 글을 넘길 때마다 글줄이 옮겨 다닌다.
      */}
      <main id="main">
        {hasHeader && <div class="post-header" set:html={headerHtml} />}
        <div class="column">
          <slot />
        </div>
        <div class="toc-rail" set:html={tocHtml} />
      </main>
    </div>

    <style>
      /* 사이드바는 fixed라 본문 열을 그만큼 밀어준다 */
      .shell {
        margin-left: var(--sidebar-w);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        /* 사이드바가 미끄러지는 것과 같은 duration·easing으로 함께 움직인다 */
        transition: margin-left 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* 사이드바를 접으면 본문이 전체 폭을 쓴다 */
      :global(html[data-sidebar='collapsed']) .shell {
        margin-left: 0;
      }

      main {
        flex: 1;
        padding: var(--space-6) var(--space-6) var(--space-16);
      }

      .column,
      .post-header {
        max-width: var(--measure);
        margin: 0 auto;
      }

      /*
       * 좁은 화면에서는 목차를 숨긴다.
       * 레일이 DOM상 본문 뒤에 있어서, 세로로 쌓으면 목차가 글 제목보다 위로 온다.
       * 글을 열자마자 목차부터 보이는 건 좋지 않고, 제목 아래로 넣으려면
       * 마크업을 이중으로 들고 있어야 한다. 목차는 여백이 있는 넓은 화면의 장치로 둔다.
       */
      .toc-rail {
        display: none;
      }

      /*
       * 넓은 화면: 본문 열 + 목차 레일을 한 묶음으로 가운데 정렬한다.
       * 목차는 화면 오른쪽 끝이 아니라 본문 바로 옆에 붙어 다닌다.
       * gap 2.5rem = 카카오 실측 41px.
       */
      @media (min-width: 84rem) {
        /*
         * 2행 그리드. 1행은 글 헤더(본문 열 폭 전체), 2행은 본문 + 목차 레일.
         * 레일이 2행에서 시작하므로 목차 첫 항목이 본문 첫 줄과 자동으로 맞는다.
         * 제목이 몇 줄이든, 태그가 있든 없든 1행 높이가 알아서 달라진다.
         *
         * 목차 유무와 상관없이 모든 페이지가 같은 격자를 쓴다 — 본문 열의
         * 가로 위치가 페이지마다 달라지지 않아야 한다.
         */
        main {
          display: grid;
          grid-template-columns: minmax(0, var(--measure)) var(--toc-w);
          column-gap: var(--space-10);
          justify-content: center;
        }

        .post-header {
          grid-column: 1;
          grid-row: 1;
          max-width: none;
          margin: 0;
        }

        .column {
          grid-column: 1;
          grid-row: 2;
          min-width: 0;
          max-width: none;
          margin: 0;
        }

        /*
         * 레일은 2행 높이(=본문 높이)만큼 늘어난다 — 안쪽 sticky가 움직일 공간이 된다.
         * align-items를 start로 주면 레일이 납작해져 sticky가 죽으니 stretch(기본)를 유지한다.
         */
        .toc-rail {
          display: block;
          grid-column: 2;
          grid-row: 2;
        }
      }

      @media (max-width: 60rem) {
        .shell {
          margin-left: 0;
        }

        main {
          padding: var(--space-4) var(--space-4) var(--space-12);
        }
      }
    </style>
  </body>
</html>
