---
import { SITE_TITLE, SITE_DESCRIPTION, LOCALE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const { title, description, image, type = 'website', pubDate } = Astro.props;

/*
 * 글에는 따로 설명문을 안 단다 — 검색결과나 링크 미리보기에 제목만 떠도 충분하다.
 * 없을 때 사이트 공통 문구로 때우면 모든 글이 같은 설명을 달고 나가므로,
 * 글 페이지에서는 아예 태그를 안 내보낸다. 목록·소개 페이지는 지금처럼 공통 문구를 쓴다.
 */
const metaDescription = description ?? (type === 'article' ? undefined : SITE_DESCRIPTION);

const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>

<title>{pageTitle}</title>
{metaDescription && <meta name="description" content={metaDescription} />}

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
{metaDescription && <meta property="og:description" content={metaDescription} />}
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta property="og:locale" content={LOCALE.replace('-', '_')} />
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

<!-- 테마·사이드바 접힘·주인 표시: 첫 페인트 전에 적용해 깜빡임 방지 -->
<script is:inline>
  /*
   * "수정" 링크는 나만 보면 되는 장치다. ?owner=1 로 한 번 들어오면 이 브라우저가
   * 기억해서 그 뒤로는 계속 보이고, ?owner=0 이면 지운다.
   * 잠금장치가 아니라 화면 정리다 — 실제 쓰기 권한은 GitHub이 막는다.
   */
  if (location.search.includes('owner=')) {
    const on = new URLSearchParams(location.search).get('owner') === '1';
    if (on) localStorage.setItem('owner', '1');
    else localStorage.removeItem('owner');
  }
  if (localStorage.getItem('owner') === '1') {
    document.documentElement.dataset.owner = '1';
  }

  const stored = localStorage.getItem('theme');
  if (stored === 'light' || stored === 'dark') {
    document.documentElement.dataset.theme = stored;
  }
  if (localStorage.getItem('sidebar:collapsed') === 'true') {
    document.documentElement.dataset.sidebar = 'collapsed';
  }
  const width = Number(localStorage.getItem('sidebar:width'));
  if (width >= 180 && width <= 480) {
    document.documentElement.style.setProperty('--sidebar-w', width + 'px');
  }
</script>
