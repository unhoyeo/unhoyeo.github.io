---
import { SITE_TITLE, AUTHOR, NAV_LINKS, SOCIAL_LINKS } from '../consts';
import { getPublishedPosts, getPostsByCategory } from '../utils';
import PanelIcon from './icons/PanelIcon.astro';

// '최근'은 전부 렌더하고, 화면에 몇 개를 보일지는 클라이언트가 정한다(무한 스크롤)
const posts = await getPublishedPosts();
const categories = await getPostsByCategory();

// 상세 글에서는 아래 '최근' 목록이 활성 표시를 가져가므로,
// 상단 네비는 정확히 그 페이지일 때만 하이라이트한다.
const path = Astro.url.pathname;
const isActive = (href: string) => path === href;

/*
 * 지금 보고 있는 글이 속한 주제는 서버에서 미리 열어둔다.
 * (localStorage 복원보다 우선 — 저장된 상태가 닫힘이어도 이건 열린 채로 둔다)
 */
const openCategory = categories.find((group) =>
  group.posts.some((post) => path === `/posts/${post.id}/`)
)?.name;
---

<aside id="sidebar" class="sidebar" data-open="false">
  <div class="sidebar__inner">
    <div class="sidebar__top">
      <a href="/" class="brand">
        <span class="brand__name">{SITE_TITLE}</span>
      </a>
      {/* 접기(넓은 화면) / 닫기(오프캔버스). 상단바의 펴기 버튼과 같은 아이콘을 쓴다 */}
      <button
        type="button"
        class="icon-btn sidebar__collapse"
        data-sidebar-collapse
        aria-controls="sidebar"
        aria-expanded="true"
        aria-label="사이드바 접기"
      >
        <PanelIcon />
      </button>
    </div>

    <nav class="sidebar__nav" aria-label="주 메뉴">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* 주제 + 최근을 한 덩어리로 스크롤한다 — 브랜드와 하단 프로필은 항상 고정 */}
    <div class="sidebar__scroll">
      {
        categories.length > 0 && (
          <nav class="sidebar__topics" aria-label="주제별 글">
            <details class="section" data-section="topics" open>
              <summary class="section-label">
                <span>주제</span>
                <svg class="chevron" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true">
                  <path
                    d="M8 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                </svg>
              </summary>
              {categories.map((group) => (
              <details
                class="topic"
                data-category={group.name}
                open={group.name === openCategory}
                data-pinned={group.name === openCategory ? 'true' : undefined}
              >
                <summary title={group.name}>
                  <svg class="chevron topic__chevron" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true">
                    <path
                      d="M8 5l5 5-5 5"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      fill="none"
                    />
                  </svg>
                  <span class="topic__name">{group.name}</span>
                  <span class="topic__count">{group.posts.length}</span>
                </summary>
                <ul>
                  {group.posts.map((post) => (
                    <li>
                      <a
                        href={`/posts/${post.id}/`}
                        aria-current={path === `/posts/${post.id}/` ? 'page' : undefined}
                        title={post.data.title}
                      >
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
              ))}
            </details>
          </nav>
        )
      }

      {/*
        '최근'은 전체 글을 다 렌더한다. 스크립트가 21번째부터 감추고 스크롤에 따라 푼다 —
        CSS로 미리 감추면 JS가 꺼진 환경에서 영영 안 보인다.
      */}
      <nav class="sidebar__recent" aria-label="최근 글">
        <details class="section" data-section="recent" open>
          <summary class="section-label">
            <span>최근</span>
            <svg class="chevron" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true">
              <path
                d="M8 5l5 5-5 5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                fill="none"></path>
            </svg>
          </summary>
          <ul>
          {
            posts.map((post) => (
              <li>
                <a
                  href={`/posts/${post.id}/`}
                  aria-current={path === `/posts/${post.id}/` ? 'page' : undefined}
                  title={post.data.title}
                >
                  {post.data.title}
                </a>
              </li>
            ))
          }
          </ul>
          {posts.length === 0 && <p class="empty">아직 글이 없습니다</p>}
          <div class="recent__sentinel" aria-hidden="true"></div>
        </details>
      </nav>

      {/*
        저장된 열림 상태 복원. 모듈 스크립트는 지연 실행이라 접혔다 펴지는 게 보인다 —
        트리 바로 뒤에서 동기로 실행해 첫 페인트 전에 상태를 맞춘다.
      */}
      <script is:inline>
        try {
          const saved = JSON.parse(localStorage.getItem('sidebar:open-categories') || '[]');
          if (Array.isArray(saved)) {
            for (const el of document.querySelectorAll('.sidebar__topics .topic')) {
              // data-pinned(=현재 글의 주제)은 저장 상태와 무관하게 열어둔다
              if (el.dataset.pinned !== 'true') el.open = saved.includes(el.dataset.category);
            }
          }
        } catch {
          /* 저장값이 깨졌으면 기본(접힘) 상태를 그대로 쓴다 */
        }

        // 섹션(주제/최근)은 카테고리와 키를 분리한다. 기본은 둘 다 펼침
        try {
          const closed = JSON.parse(localStorage.getItem('sidebar:open-sections') || 'null');
          if (closed && typeof closed === 'object') {
            for (const el of document.querySelectorAll('.sidebar__scroll .section')) {
              if (el.dataset.section in closed) el.open = !!closed[el.dataset.section];
            }
          }
        } catch {
          /* 저장값이 깨졌으면 기본(펼침) 상태를 그대로 쓴다 */
        }
      </script>
    </div>

    <div class="sidebar__bottom">
      <a href="/about/" class="profile">
        <span class="profile__avatar" aria-hidden="true">{AUTHOR.slice(0, 1)}</span>
        <span class="profile__name">{AUTHOR}</span>
      </a>
      <div class="sidebar__links">
        {
          SOCIAL_LINKS.map((link) => (
            <a href={link.href} rel="me noopener" target="_blank">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</aside>

<div class="scrim" data-sidebar-close aria-hidden="true"></div>

<style>
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--sidebar-w);
    background: var(--bg-sidebar);
    border-right: 1px solid var(--border);
    z-index: 40;
    /*
     * 접기·오프캔버스 모두 같은 값으로 미끄러진다(.shell의 margin-left도 동일).
     * visibility는 보간이 이산적이라 이 목록에 넣어두면 이동이 끝난 뒤에 hidden이 된다 —
     * 접히는 동안 내용이 보이면서 빠져나간다.
     */
    transition:
      transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* 위쪽 패딩은 .sidebar__top이 직접 갖는다 — 상단바와 높이를 맞춰야 하므로 */
    padding: 0 var(--space-3) var(--space-3);
    gap: var(--space-4);
  }

  /*
   * 상단바와 같은 높이를 갖고 내용물을 세로 가운데 정렬한다.
   * 사이드바를 접으면 아이콘이 상단바로 옮겨가는데, 두 영역의 중심선이 같아야 튀지 않는다.
   */
  .sidebar__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    height: var(--topbar-h);
    flex: none;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    border-radius: var(--radius);
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
    /* 로고 자리라 UI 기본(14px)보다 한 단계 크게 — 하단 프로필과 위계를 가른다 */
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    /* 패딩이 위아래 대칭이어야 글자 중심이 상단바 기준선과 맞는다 */
    padding: var(--space-2);
  }

  /*
   * 로고 자리라 hover에 아무 시각 변화도 주지 않는다(배경도 글자색도).
   * 키보드 포커스 표시는 global.css의 전역 :focus-visible 규칙이 담당한다.
   */

  /*
   * 섹션 라벨은 이제 summary다. 셰브론이 라벨 글자 바로 오른쪽에 붙고,
   * 클릭 영역도 글자+셰브론 폭까지만이다(사이드바 전체 폭이 아니라).
   */
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    margin: 0 0 var(--space-1);
    padding: 0 var(--space-2);
    color: var(--fg-faint);
    font-size: var(--text-xs);
    line-height: var(--leading-ui);
    cursor: pointer;
    list-style: none;
  }

  .section-label::-webkit-details-marker {
    display: none;
  }

  .section-label:hover {
    color: var(--fg-muted);
  }

  .chevron {
    flex: none;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .section[open] > .section-label .chevron {
    transform: rotate(90deg);
  }

  .sidebar__nav ul,
  .sidebar__recent ul,
  .sidebar__topics ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 목록 항목은 ChatGPT 사이드바처럼 한 줄로 자르고 라운드 하이라이트 */
  .sidebar__nav a,
  .sidebar__recent a,
  .sidebar__topics a {
    display: block;
    padding: var(--space-2);
    border-radius: var(--radius);
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar__nav a:hover,
  .sidebar__recent a:hover,
  .sidebar__topics a:hover {
    background: var(--bg-hover);
    color: var(--fg);
  }

  .sidebar__nav a[aria-current='page'],
  .sidebar__recent a[aria-current='page'],
  .sidebar__topics a[aria-current='page'] {
    background: var(--bg-active);
    color: var(--fg);
  }

  /*
   * '최근'과 '주제'를 한 덩어리로 스크롤한다.
   * 상단 브랜드와 하단 프로필은 이 영역 밖이라 항상 고정된다.
   */
  .sidebar__scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    /* 끝까지 내렸을 때 본문으로 스크롤이 번지지 않게 */
    overscroll-behavior: contain;
    scrollbar-width: thin;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* --- 주제 트리 --- */

  .topic > summary {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2);
    border-radius: var(--radius);
    color: var(--fg-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    cursor: pointer;
    list-style: none; /* 기본 삼각형 마커 제거 */
  }

  .topic > summary::-webkit-details-marker {
    display: none;
  }

  .topic > summary:hover {
    background: var(--bg-hover);
    color: var(--fg);
  }

  .topic[open] > summary .topic__chevron {
    transform: rotate(90deg);
  }

  .topic__name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .topic__count {
    margin-left: auto;
    padding-left: var(--space-2);
    color: var(--fg-faint);
    font-size: var(--text-xs);
  }

  /* 글 항목은 셰브론(12px) + gap 만큼 들여쓴다 */
  .topic > ul a {
    padding-left: calc(var(--space-2) + 12px + var(--space-1));
  }

  .empty {
    padding: 0 var(--space-2);
    color: var(--fg-faint);
    font-size: var(--text-sm);
  }

  .sidebar__bottom {
    border-top: 1px solid var(--border);
    padding-top: var(--space-2);
  }

  .profile {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    border-radius: var(--radius);
    color: var(--fg);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
  }

  .profile:hover {
    background: var(--bg-hover);
  }

  .profile__avatar {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--bg-active);
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }

  .sidebar__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-2) var(--space-2);
    font-size: var(--text-xs);
  }

  .sidebar__links a {
    color: var(--fg-faint);
    text-decoration: none;
  }

  .sidebar__links a:hover {
    color: var(--fg);
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: var(--fg-muted);
    cursor: pointer;
  }

  .icon-btn:hover {
    background: var(--bg-hover);
    color: var(--fg);
  }

  /*
   * 넓은 화면 접기. 좁은 화면의 오프캔버스(data-open)와 섞이지 않도록
   * 60rem 초과에서만 적용한다.
   */
  @media (min-width: 60.0625rem) {
    :global(html[data-sidebar='collapsed']) .sidebar {
      transform: translateX(-100%);
      visibility: hidden;
    }
  }

  .scrim {
    display: none;
  }

  /* 데스크톱보다 좁으면 사이드바를 오프캔버스로 */
  @media (max-width: 60rem) {
    /* transition 값은 위 기본 규칙과 같다 */
    .sidebar {
      transform: translateX(-100%);
    }

    .sidebar[data-open='true'] {
      transform: none;
      box-shadow: 0 0 2rem rgb(0 0 0 / 0.2);
    }

    .sidebar[data-open='true'] ~ .scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 30;
      background: rgb(0 0 0 / 0.4);
    }
  }
</style>

<script>
  /*
   * 열고 닫은 상태를 저장한다. 복원은 트리 바로 뒤 is:inline 스크립트가 하고
   * (깜빡임 방지), 저장은 급하지 않으므로 여기서 한다.
   */
  const KEY = 'sidebar:open-categories';
  const topics = document.querySelectorAll<HTMLDetailsElement>('.sidebar__topics .topic');

  const save = () => {
    const open = [...topics].filter((el) => el.open).map((el) => el.dataset.category ?? '');
    try {
      localStorage.setItem(KEY, JSON.stringify(open));
    } catch {
      /* 저장 실패(사생활 보호 모드 등)는 무시한다 — 화면 동작에는 영향 없다 */
    }
  };

  topics.forEach((el) => el.addEventListener('toggle', save));

  /* 섹션(주제/최근)은 기본이 '펼침'이라 이름 목록이 아니라 이름→불리언으로 저장한다 */
  const sections = document.querySelectorAll<HTMLDetailsElement>('.sidebar__scroll .section');

  const saveSections = () => {
    const state: Record<string, boolean> = {};
    sections.forEach((el) => {
      if (el.dataset.section) state[el.dataset.section] = el.open;
    });
    try {
      localStorage.setItem('sidebar:open-sections', JSON.stringify(state));
    } catch {
      /* 저장 실패는 무시 */
    }
  };

  sections.forEach((el) => el.addEventListener('toggle', saveSections));

  /*
   * '최근' 무한 스크롤. 전체가 이미 DOM에 있으므로 네트워크 요청이 없다.
   * 여기서 처음 STEP개만 남기고 감춘 뒤, sentinel이 보일 때마다 STEP개씩 푼다.
   * (JS가 없으면 이 코드가 안 돌아 전체가 그냥 보인다 — 그게 맞는 폴백이다)
   */
  const STEP = 20;
  const scroller = document.querySelector<HTMLElement>('.sidebar__scroll');
  const sentinel = document.querySelector<HTMLElement>('.recent__sentinel');
  const items = [...document.querySelectorAll<HTMLLIElement>('.sidebar__recent li')];

  if (scroller && sentinel) {
    if (items.length <= STEP) {
      sentinel.remove();
    } else {
      let shown = STEP;
      const apply = () => items.forEach((li, i) => (li.hidden = i >= shown));
      apply();

      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          shown += STEP;
          apply();
          if (shown >= items.length) {
            io.disconnect();
            sentinel.remove();
          }
        },
        // 관측 루트는 window가 아니라 사이드바의 스크롤 컨테이너다
        { root: scroller, rootMargin: '96px' }
      );

      io.observe(sentinel);
    }
  }
</script>
