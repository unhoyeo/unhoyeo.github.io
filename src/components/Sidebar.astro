---
import { SITE_TITLE, AUTHOR, NAV_LINKS } from '../consts';
import { getPublishedPosts, getPostsByCategory, parseCategory, categoryAncestors } from '../utils';
import PanelIcon from './icons/PanelIcon.astro';
import CategoryTree from './CategoryTree.astro';

// '최근'은 전부 렌더하고, 화면에 몇 개를 보일지는 클라이언트가 정한다(무한 스크롤)
const posts = await getPublishedPosts();
const categories = await getPostsByCategory();

// 상세 글에서는 아래 '최근' 목록이 활성 표시를 가져가므로,
// 상단 네비는 정확히 그 페이지일 때만 하이라이트한다.
const path = Astro.url.pathname;
const isActive = (href: string) => path === href;

/*
 * 지금 보고 있는 글이 속한 주제는 서버에서 미리 열어둔다. 중첩이므로 조상까지 전부.
 * (localStorage 복원보다 우선 — 저장된 상태가 닫힘이어도 이건 열린 채로 둔다)
 */
const currentPost = posts.find((post) => path === `/posts/${post.id}/`);
const pinnedPaths = currentPost
  ? categoryAncestors(parseCategory(currentPost.data.category))
  : [];
---

<aside id="sidebar" class="sidebar" data-open="false">
  <div class="sidebar__inner">
    <div class="sidebar__top">
      <a href="/" class="brand">
        <span class="brand__name">{SITE_TITLE}</span>
      </a>
      {/* 접기(넓은 화면) / 닫기(오프캔버스). 상단바의 펴기 버튼과 같은 아이콘을 쓴다 */}
      <button
        type="button"
        class="icon-btn sidebar__collapse"
        data-sidebar-collapse
        aria-controls="sidebar"
        aria-expanded="true"
        aria-label="사이드바 접기"
      >
        <PanelIcon />
      </button>
    </div>

    <nav class="sidebar__nav" aria-label="주 메뉴">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* 주제 + 최근을 한 덩어리로 스크롤한다 — 브랜드와 하단 프로필은 항상 고정 */}
    <div class="sidebar__scroll">
      {
        categories.length > 0 && (
          <nav class="sidebar__topics" aria-label="주제별 글">
            <details class="section" data-section="topics" open>
              <summary class="section-label">
                <span>주제</span>
                <svg class="chevron" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true">
                  <path
                    d="M8 5l5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                </svg>
              </summary>
              {categories.map((node) => (
                <CategoryTree node={node} path={path} pinned={pinnedPaths} />
              ))}
            </details>
          </nav>
        )
      }

      {/*
        '최근'은 전체 글을 다 렌더한다. 스크립트가 21번째부터 감추고 스크롤에 따라 푼다 —
        CSS로 미리 감추면 JS가 꺼진 환경에서 영영 안 보인다.
      */}
      <nav class="sidebar__recent" aria-label="최근 글">
        <details class="section" data-section="recent" open>
          <summary class="section-label">
            <span>최근</span>
            <svg class="chevron" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true">
              <path
                d="M8 5l5 5-5 5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                fill="none"></path>
            </svg>
          </summary>
          <ul>
          {
            posts.map((post) => (
              <li>
                <a
                  href={`/posts/${post.id}/`}
                  aria-current={path === `/posts/${post.id}/` ? 'page' : undefined}
                  title={post.data.title}
                >
                  {post.data.title}
                </a>
              </li>
            ))
          }
          </ul>
          {posts.length === 0 && <p class="empty">아직 글이 없습니다</p>}
          <div class="recent__sentinel" aria-hidden="true"></div>
        </details>
      </nav>

      {/*
        저장된 열림 상태 복원. 모듈 스크립트는 지연 실행이라 접혔다 펴지는 게 보인다 —
        트리 바로 뒤에서 동기로 실행해 첫 페인트 전에 상태를 맞춘다.
      */}
      <script is:inline>
        try {
          const saved = JSON.parse(localStorage.getItem('sidebar:open-categories') || '[]');
          if (Array.isArray(saved)) {
            for (const el of document.querySelectorAll('.sidebar__topics .topic')) {
              // data-pinned(=현재 글의 주제)은 저장 상태와 무관하게 열어둔다
              if (el.dataset.pinned !== 'true') el.open = saved.includes(el.dataset.category);
            }
          }
        } catch {
          /* 저장값이 깨졌으면 기본(접힘) 상태를 그대로 쓴다 */
        }

        // 섹션(주제/최근)은 카테고리와 키를 분리한다. 기본은 둘 다 펼침
        try {
          const closed = JSON.parse(localStorage.getItem('sidebar:open-sections') || 'null');
          if (closed && typeof closed === 'object') {
            for (const el of document.querySelectorAll('.sidebar__scroll .section')) {
              if (el.dataset.section in closed) el.open = !!closed[el.dataset.section];
            }
          }
        } catch {
          /* 저장값이 깨졌으면 기본(펼침) 상태를 그대로 쓴다 */
        }
      </script>
    </div>

    <div class="sidebar__bottom">
      <a href="/about/" class="profile">
        <span class="profile__avatar" aria-hidden="true">{AUTHOR.slice(0, 1)}</span>
        <span class="profile__name">{AUTHOR}</span>
      </a>
      {/* 외부 링크(GitHub 등)는 소개 페이지로 옮겼다 — 사이드바 하단은 프로필만 */}
    </div>
  </div>

  {/*
    너비 조절 손잡이. separator 롤이라 스크린리더에도 조절 가능한 요소로 읽히고,
    포인터를 못 쓰는 경우를 위해 좌우 방향키로도 움직인다.
  */}
  <div
    class="sidebar__resizer"
    role="separator"
    aria-orientation="vertical"
    aria-label="사이드바 너비 조절"
    title="드래그해서 너비 조절 · 더블클릭하면 기본값"
    tabindex="0"
  >
  </div>
</aside>

<div class="scrim" data-sidebar-close aria-hidden="true"></div>

<style>
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--sidebar-w);
    background: var(--bg-sidebar);
    border-right: 1px solid var(--border);
    z-index: 40;
    /*
     * 접기·오프캔버스 모두 같은 값으로 미끄러진다(.shell의 margin-left도 동일).
     * visibility는 보간이 이산적이라 이 목록에 넣어두면 이동이 끝난 뒤에 hidden이 된다 —
     * 접히는 동안 내용이 보이면서 빠져나간다.
     */
    transition:
      transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /*
   * 너비 조절 손잡이. 경계선 위에 걸치도록 살짝 밖으로 빼서, 선을 정확히
   * 겨냥하지 않아도 잡힌다. 평소에는 보이지 않고 커서를 올렸을 때만 드러난다.
   */
  .sidebar__resizer {
    position: absolute;
    top: 0;
    right: -3px;
    bottom: 0;
    width: 7px;
    z-index: 1;
    cursor: col-resize;
    /* 포인터 이벤트로만 다룬다 — 브라우저가 끼어들어 스크롤/줌으로 해석하지 않도록 */
    touch-action: none;
  }

  .sidebar__resizer::after {
    content: '';
    position: absolute;
    inset: 0 3px;
    background: var(--border-strong);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .sidebar__resizer:hover::after,
  .sidebar__resizer:focus-visible::after,
  :global(html[data-resizing]) .sidebar__resizer::after {
    opacity: 1;
  }

  .sidebar__resizer:focus-visible {
    outline: none;
  }

  /* 접혀 있으면 조절할 대상이 없다 */
  :global(html[data-sidebar='collapsed']) .sidebar__resizer {
    display: none;
  }

  /*
   * 드래그하는 동안에는 폭이 커서를 그대로 따라와야 한다.
   * 미끄러짐(transition)을 켜둔 채로 끌면 손잡이보다 사이드바가 늦게 따라와 미끌거린다.
   */
  :global(html[data-resizing]) .sidebar,
  :global(html[data-resizing]) :global(.shell) {
    transition: none;
  }

  /* 끄는 도중 본문 글자가 선택되는 것을 막는다 */
  :global(html[data-resizing]) {
    cursor: col-resize;
    user-select: none;
  }

  .sidebar__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* 위쪽 패딩은 .sidebar__top이 직접 갖는다 — 상단바와 높이를 맞춰야 하므로 */
    padding: 0 var(--space-3) var(--space-3);
    gap: var(--space-4);
  }

  /*
   * 상단바와 같은 높이를 갖고 내용물을 세로 가운데 정렬한다.
   * 사이드바를 접으면 아이콘이 상단바로 옮겨가는데, 두 영역의 중심선이 같아야 튀지 않는다.
   */
  .sidebar__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    height: var(--topbar-h);
    flex: none;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    border-radius: var(--radius);
    color: var(--sidebar-fg);
    text-decoration: none;
    font-weight: 600;
    /* 로고 자리라 UI 기본(14px)보다 한 단계 크게 — 하단 프로필과 위계를 가른다 */
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    /* 패딩이 위아래 대칭이어야 글자 중심이 상단바 기준선과 맞는다 */
    padding: var(--space-2);
    /*
     * 폭을 최소로 줄이면 블로그 이름이 두 줄로 접히면서 상단 높이가 늘어난다.
     * 접지 말고 넘치는 만큼만 잘라낸다 — 높이가 흔들리지 않아야 접기 버튼과
     * 상단바 아이콘의 중심선이 유지된다.
     */
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
  }

  .brand__name {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /*
   * 로고 자리라 hover에 아무 시각 변화도 주지 않는다(배경도 글자색도).
   * 키보드 포커스 표시는 global.css의 전역 :focus-visible 규칙이 담당한다.
   */

  /*
   * 섹션 라벨은 이제 summary다. 셰브론이 라벨 글자 바로 오른쪽에 붙고,
   * 클릭 영역도 글자+셰브론 폭까지만이다(사이드바 전체 폭이 아니라).
   */
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    margin: 0 0 var(--space-1);
    padding: 0 var(--space-2);
    color: var(--sidebar-fg-label);
    /* 사이드바의 다른 항목(네비·카테고리·글 제목)과 같은 크기 */
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    cursor: pointer;
    list-style: none;
  }

  .section-label::-webkit-details-marker {
    display: none;
  }

  /*
   * 섹션 라벨은 hover 시 아무 변화도 주지 않는다.
   * 접히고 펴진다는 신호는 셰브론이 이미 하고 있고, 포커스 표시는
   * global.css의 :focus-visible 전역 규칙이 그대로 담당한다.
   */

  .chevron {
    flex: none;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .section[open] > .section-label .chevron {
    transform: rotate(90deg);
  }

  /*
   * 섹션 라벨(주제·최근)의 셰브론은 평소엔 숨겨두고 hover에서 떠오른다.
   * opacity만 바꾸므로 자리는 계속 차지한다 — 나타날 때 라벨이 밀리지 않는다.
   * 키보드로 왔을 때도 보여야 해서 :focus-visible을 함께 건다.
   */
  .section-label .chevron {
    opacity: 0;
    transition:
      opacity 0.15s ease,
      transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .section-label:hover .chevron,
  .section-label:focus-visible .chevron {
    opacity: 1;
  }

  .sidebar__nav ul,
  .sidebar__recent ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 목록 항목은 ChatGPT 사이드바처럼 한 줄로 자르고 라운드 하이라이트 */
  .sidebar__nav a,
  .sidebar__recent a {
    display: block;
    padding: var(--space-2);
    border-radius: var(--radius);
    color: var(--sidebar-fg);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar__nav a:hover,
  .sidebar__recent a:hover {
    background: var(--bg-hover);
    color: var(--sidebar-fg-active);
  }

  .sidebar__nav a[aria-current='page'],
  .sidebar__recent a[aria-current='page'] {
    background: var(--bg-active);
    color: var(--sidebar-fg-active);
  }

  /*
   * '최근'과 '주제'를 한 덩어리로 스크롤한다.
   * 상단 브랜드와 하단 프로필은 이 영역 밖이라 항상 고정된다.
   */
  .sidebar__scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    /* 끝까지 내렸을 때 본문으로 스크롤이 번지지 않게 */
    overscroll-behavior: contain;
    scrollbar-width: thin;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* 주제 트리 노드의 생김새는 CategoryTree.astro가 갖는다(스코프가 다르므로) */

  .empty {
    padding: 0 var(--space-2);
    color: var(--sidebar-fg-label);
    font-size: var(--text-sm);
  }

  .sidebar__bottom {
    border-top: 1px solid var(--border);
    padding-top: var(--space-2);
  }

  .profile {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    border-radius: var(--radius);
    color: var(--sidebar-fg);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
  }

  .profile:hover {
    background: var(--bg-hover);
  }

  .profile__avatar {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--bg-active);
    color: var(--sidebar-fg-label);
    font-size: var(--text-xs);
  }

  .sidebar__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-2) var(--space-2);
    font-size: var(--text-xs);
  }

  .sidebar__links a {
    color: var(--sidebar-fg-label);
    text-decoration: none;
  }

  .sidebar__links a:hover {
    color: var(--sidebar-fg-active);
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: var(--sidebar-fg-label);
    cursor: pointer;
  }

  .icon-btn:hover {
    background: var(--bg-hover);
    color: var(--sidebar-fg-active);
  }

  /*
   * 넓은 화면 접기. 좁은 화면의 오프캔버스(data-open)와 섞이지 않도록
   * 60rem 초과에서만 적용한다.
   */
  @media (min-width: 60.0625rem) {
    :global(html[data-sidebar='collapsed']) .sidebar {
      transform: translateX(-100%);
      visibility: hidden;
    }
  }

  .scrim {
    display: none;
  }

  /* 데스크톱보다 좁으면 사이드바를 오프캔버스로 */
  @media (max-width: 60rem) {
    /* transition 값은 위 기본 규칙과 같다 */
    .sidebar {
      transform: translateX(-100%);
    }

    /*
     * 좁은 화면에서는 사이드바가 본문 위를 덮는 오프캔버스라 폭을 줄일 이유가 없고,
     * 손가락으로 끌면 스크롤과 충돌한다.
     */
    .sidebar__resizer {
      display: none;
    }

    .sidebar[data-open='true'] {
      transform: none;
      box-shadow: 0 0 2rem rgb(0 0 0 / 0.2);
    }

    .sidebar[data-open='true'] ~ .scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 30;
      background: rgb(0 0 0 / 0.4);
    }
  }
</style>

<script>
  /*
   * 너비 조절. 값은 --sidebar-w 하나만 바꾼다 — 본문(.shell의 margin-left)이
   * 같은 변수를 보고 있어서 따로 손댈 곳이 없다.
   * 복원은 <head>의 is:inline 스크립트가 첫 페인트 전에 한다(깜빡임 방지).
   */
  const WIDTH_KEY = 'sidebar:width';
  const MIN_W = 180;
  const MAX_W = 480;

  const root = document.documentElement;
  const resizer = document.querySelector<HTMLElement>('.sidebar__resizer');
  const aside = document.querySelector<HTMLElement>('.sidebar');

  if (resizer && aside) {
    /** 화면 밖으로 나가거나 본문이 사라질 만큼은 못 끌게 막는다 */
    const applyWidth = (px: number) => {
      const w = Math.round(Math.min(MAX_W, Math.max(MIN_W, px)));
      root.style.setProperty('--sidebar-w', `${w}px`);
      return w;
    };

    const remember = (w: number) => {
      try {
        localStorage.setItem(WIDTH_KEY, String(w));
      } catch {
        /* 저장 실패는 무시한다 — 이번 세션 동안은 그대로 쓰인다 */
      }
    };

    resizer.addEventListener('pointerdown', (event) => {
      // 기본 동작(글자 선택, 드래그 시작)을 막아야 커서가 매끄럽게 따라온다
      event.preventDefault();
      root.dataset.resizing = '';

      /*
       * 커서의 절대 위치가 아니라 '눌렀을 때부터 움직인 거리'로 계산한다.
       * 절대 위치를 쓰면 손잡이(7px) 안에서 어디를 눌렀느냐에 따라 폭이
       * 몇 px 튀어서, 그냥 클릭만 해도 미세하게 조절돼 버린다.
       */
      const startX = event.clientX;
      const startWidth = aside.getBoundingClientRect().width;

      /*
       * 이동·종료는 window에서 듣는다. 포인터 캡처에 기대면 캡처가 실패하는
       * 경우(합성 입력, 일부 펜/터치 장치)에 드래그가 통째로 죽는다.
       * 캡처는 커서가 손잡이 밖으로 나가도 이벤트를 유지해 주는 보너스로만 쓴다.
       */
      try {
        resizer.setPointerCapture(event.pointerId);
      } catch {
        /* 캡처를 못 걸어도 window 리스너가 있으므로 계속 진행한다 */
      }

      const widthAt = (e: PointerEvent) => startWidth + (e.clientX - startX);
      const onMove = (e: PointerEvent) => applyWidth(widthAt(e));

      const onUp = (e: PointerEvent) => {
        // 움직이지 않았으면(=그냥 클릭) 아무것도 바꾸지 않는다
        if (e.clientX !== startX) remember(applyWidth(widthAt(e)));
        delete root.dataset.resizing;
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', onUp);
        window.removeEventListener('pointercancel', onUp);
      };

      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onUp);
    });

    /* 더블클릭하면 기본 너비로 되돌린다 */
    resizer.addEventListener('dblclick', () => {
      root.style.removeProperty('--sidebar-w');
      try {
        localStorage.removeItem(WIDTH_KEY);
      } catch {
        /* 무시 */
      }
    });

    /* 포인터를 쓰기 어려운 경우를 위한 방향키 조절 */
    resizer.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const step = event.shiftKey ? 32 : 8;
      const current = aside.getBoundingClientRect().width;
      remember(applyWidth(current + (event.key === 'ArrowRight' ? step : -step)));
    });
  }

  /*
   * 잘린 글 제목에 커서를 올리면 뒷부분이 보이도록 왼쪽으로 밀어준다.
   * 넘친 만큼만 밀고 멈춘다(반복하지 않는다). 커서가 벗어나면 제자리로.
   *
   * 감싸는 요소를 새로 만들지 않고 text-indent를 음수로 주는 방식이다 —
   * 마크업을 건드리지 않아도 되고, 다 밀리면 넘치는 폭이 0이 되어
   * 말줄임표(…)도 저절로 사라진다.
   */
  const marqueeRoot = document.querySelector<HTMLElement>('.sidebar__scroll');
  const slowMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (marqueeRoot && !slowMotion) {
    const PX_PER_SEC = 90; // 읽을 수 있을 만큼만 천천히

    const reveal = (link: HTMLElement) => {
      const hidden = link.scrollWidth - link.clientWidth;
      if (hidden <= 0) return; // 안 잘린 제목은 건드리지 않는다
      link.style.transition = `text-indent ${Math.round((hidden / PX_PER_SEC) * 1000)}ms linear`;
      link.style.textIndent = `-${hidden}px`;
    };

    const restore = (link: HTMLElement) => {
      link.style.transition = 'text-indent 0.2s ease';
      link.style.textIndent = '';
    };

    // pointerenter/leave와 달리 over/out은 버블링되므로 위임해서 한 번만 단다
    marqueeRoot.addEventListener('pointerover', (event) => {
      const link = (event.target as HTMLElement)?.closest?.('a');
      if (link && marqueeRoot.contains(link)) reveal(link);
    });

    marqueeRoot.addEventListener('pointerout', (event) => {
      const link = (event.target as HTMLElement)?.closest?.('a');
      if (link) restore(link);
    });
  }

  /*
   * 열고 닫은 상태를 저장한다. 복원은 트리 바로 뒤 is:inline 스크립트가 하고
   * (깜빡임 방지), 저장은 급하지 않으므로 여기서 한다.
   */
  const KEY = 'sidebar:open-categories';
  const topics = document.querySelectorAll<HTMLDetailsElement>('.sidebar__topics .topic');

  const save = () => {
    const open = [...topics].filter((el) => el.open).map((el) => el.dataset.category ?? '');
    try {
      localStorage.setItem(KEY, JSON.stringify(open));
    } catch {
      /* 저장 실패(사생활 보호 모드 등)는 무시한다 — 화면 동작에는 영향 없다 */
    }
  };

  topics.forEach((el) => el.addEventListener('toggle', save));

  /* 섹션(주제/최근)은 기본이 '펼침'이라 이름 목록이 아니라 이름→불리언으로 저장한다 */
  const sections = document.querySelectorAll<HTMLDetailsElement>('.sidebar__scroll .section');

  const saveSections = () => {
    const state: Record<string, boolean> = {};
    sections.forEach((el) => {
      if (el.dataset.section) state[el.dataset.section] = el.open;
    });
    try {
      localStorage.setItem('sidebar:open-sections', JSON.stringify(state));
    } catch {
      /* 저장 실패는 무시 */
    }
  };

  sections.forEach((el) => el.addEventListener('toggle', saveSections));

  /*
   * '주제' 섹션을 접으면 그 안의 카테고리 토글도 전부 접는다.
   * 안 그러면 다시 펼쳤을 때 예전에 열어둔 것들이 그대로 쏟아져 나온다.
   * data-pinned(현재 글의 주제)도 같이 접는다 — 접었다는 행동이 더 최근 의사다.
   * 페이지를 다시 열면 서버가 현재 글의 조상을 다시 열어준다.
   */
  document.querySelector('.sidebar__topics .section')?.addEventListener('toggle', (event) => {
    const section = event.currentTarget as HTMLDetailsElement;
    if (section.open) return;

    let changed = false;
    section.querySelectorAll<HTMLDetailsElement>('.topic[open]').forEach((topic) => {
      topic.open = false;
      changed = true;
    });
    // 각 토글의 'toggle' 이벤트가 save()를 부르지만, 한 번 더 불러 확실히 맞춘다
    if (changed) save();
  });

  /*
   * '최근' 무한 스크롤. 전체가 이미 DOM에 있으므로 네트워크 요청이 없다.
   * 여기서 처음 STEP개만 남기고 감춘 뒤, sentinel이 보일 때마다 STEP개씩 푼다.
   * (JS가 없으면 이 코드가 안 돌아 전체가 그냥 보인다 — 그게 맞는 폴백이다)
   */
  const STEP = 20;
  const scroller = document.querySelector<HTMLElement>('.sidebar__scroll');
  const sentinel = document.querySelector<HTMLElement>('.recent__sentinel');
  const items = [...document.querySelectorAll<HTMLLIElement>('.sidebar__recent li')];

  if (scroller && sentinel) {
    if (items.length <= STEP) {
      sentinel.remove();
    } else {
      let shown = STEP;
      const apply = () => items.forEach((li, i) => (li.hidden = i >= shown));
      apply();

      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          shown += STEP;
          apply();
          if (shown >= items.length) {
            io.disconnect();
            sentinel.remove();
          }
        },
        // 관측 루트는 window가 아니라 사이드바의 스크롤 컨테이너다
        { root: scroller, rootMargin: '96px' }
      );

      io.observe(sentinel);
    }
  }
</script>
