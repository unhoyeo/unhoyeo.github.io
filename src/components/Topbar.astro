---
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<div class="topbar">
  <button type="button" class="icon-btn menu" data-sidebar-open aria-label="메뉴 열기">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
      <path
        d="M3 5h14M3 10h14M3 15h14"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        fill="none"></path>
    </svg>
  </button>

  {label && <p class="label">{label}</p>}

  <button type="button" class="icon-btn theme" id="theme-toggle" aria-label="테마 전환">
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
      <path
        d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 0v16"
        stroke="currentColor"
        stroke-width="1.4"
        fill="none"></path>
      <path d="M10 2a8 8 0 010 16z" fill="currentColor"></path>
    </svg>
  </button>
</div>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3rem;
    padding: 0 var(--space-3);
    background: var(--bg);
  }

  .label {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .theme {
    margin-left: auto;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: var(--fg-muted);
    cursor: pointer;
  }

  .icon-btn:hover {
    background: var(--bg-hover);
    color: var(--fg);
  }

  .menu {
    display: none;
  }

  @media (max-width: 60rem) {
    .menu {
      display: grid;
    }
  }
</style>

<script>
  const root = document.documentElement;

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current =
      root.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });

  const sidebar = document.getElementById('sidebar');
  const setOpen = (open: boolean) => sidebar?.setAttribute('data-open', String(open));

  document
    .querySelectorAll('[data-sidebar-open]')
    .forEach((el) => el.addEventListener('click', () => setOpen(true)));
  document
    .querySelectorAll('[data-sidebar-close]')
    .forEach((el) => el.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
