---
import PanelIcon from './icons/PanelIcon.astro';

interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<div class="topbar">
  <button
    type="button"
    class="icon-btn menu"
    data-sidebar-open
    aria-controls="sidebar"
    aria-expanded="false"
    aria-label="사이드바 펼치기"
  >
    <PanelIcon />
  </button>

  {label && <p class="label">{label}</p>}

  <button type="button" class="icon-btn theme" id="theme-toggle" aria-label="테마 전환">
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
      <path
        d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 0v16"
        stroke="currentColor"
        stroke-width="1.4"
        fill="none"></path>
      <path d="M10 2a8 8 0 010 16z" fill="currentColor"></path>
    </svg>
  </button>
</div>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--topbar-h);
    padding: 0 var(--space-3);
    background: var(--bg);
  }

  .label {
    margin: 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .theme {
    margin-left: auto;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: var(--fg-muted);
    cursor: pointer;
  }

  .icon-btn:hover {
    background: var(--bg-hover);
    color: var(--fg);
  }

  .menu {
    display: none;
  }

  /* 넓은 화면에서는 사이드바가 접혀 있을 때만 펼치기 버튼을 보인다 */
  :global(html[data-sidebar='collapsed']) .menu {
    display: grid;
  }

  @media (max-width: 60rem) {
    .menu {
      display: grid;
    }
  }
</style>

<script>
  const root = document.documentElement;

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current =
      root.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });

  const sidebar = document.getElementById('sidebar');
  const openBtns = document.querySelectorAll('[data-sidebar-open]');
  const collapseBtns = document.querySelectorAll('[data-sidebar-collapse]');

  /*
   * 같은 버튼이 폭에 따라 다른 일을 한다.
   * 좁은 화면: 오프캔버스 열기/닫기(data-open). 넓은 화면: 접기/펴기(html[data-sidebar]).
   * 두 상태를 따로 들고 있어서 서로 간섭하지 않는다.
   */
  const narrow = window.matchMedia('(max-width: 60rem)');

  const syncLabels = () => {
    const expanded = String(
      narrow.matches
        ? sidebar?.dataset.open === 'true'
        : root.dataset.sidebar !== 'collapsed'
    );
    [...openBtns, ...collapseBtns].forEach((el) => el.setAttribute('aria-expanded', expanded));
  };

  const setOpen = (open: boolean) => {
    sidebar?.setAttribute('data-open', String(open));
    syncLabels();
  };

  const setCollapsed = (collapsed: boolean) => {
    if (collapsed) root.dataset.sidebar = 'collapsed';
    else delete root.dataset.sidebar;
    try {
      localStorage.setItem('sidebar:collapsed', String(collapsed));
    } catch {
      /* 저장 실패는 무시 — 이번 세션 동안만 적용된다 */
    }
    syncLabels();
  };

  openBtns.forEach((el) =>
    el.addEventListener('click', () => (narrow.matches ? setOpen(true) : setCollapsed(false)))
  );
  collapseBtns.forEach((el) =>
    el.addEventListener('click', () => (narrow.matches ? setOpen(false) : setCollapsed(true)))
  );

  // 오프캔버스 전용 닫기(스크림 등)
  document
    .querySelectorAll('[data-sidebar-close]')
    .forEach((el) => el.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  narrow.addEventListener('change', syncLabels);
  syncLabels();
</script>
