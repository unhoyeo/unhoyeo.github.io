---
/*
 * 사이드바 접기/펴기 아이콘. 접힌 상태(상단바)와 펼친 상태(사이드바)가
 * 같은 기능이므로 같은 아이콘을 쓴다 — 양쪽이 이 컴포넌트를 공유한다.
 */
interface Props {
  size?: number;
}

const { size = 16 } = Astro.props;
---

<svg viewBox="0 0 20 20" width={size} height={size} aria-hidden="true">
  <rect
    x="2.5"
    y="3.5"
    width="15"
    height="13"
    rx="2.5"
    stroke="currentColor"
    stroke-width="1.4"
    fill="none"></rect>
  <path d="M8 3.5v13" stroke="currentColor" stroke-width="1.4" fill="none"></path>
</svg>
