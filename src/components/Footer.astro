---
import { AUTHOR, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container-wide row">
    <p>© {year} {AUTHOR}</p>
    <ul>
      {
        SOCIAL_LINKS.map((link) => (
          <li>
            <a href={link.href} rel="me noopener" target="_blank">
              {link.label}
            </a>
          </li>
        ))
      }
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-16);
    padding: var(--space-8) 0;
    color: var(--fg-faint);
    font-size: var(--text-sm);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--fg-faint);
  }

  a:hover {
    color: var(--fg);
  }
</style>
