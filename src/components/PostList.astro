---
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../utils';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}/`} class="card">
          <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
          <h2>{post.data.title}</h2>
          {post.data.description && <p>{post.data.description}</p>}
          {post.data.tags.length > 0 && (
            <p class="tags">{post.data.tags.map((tag) => `#${tag}`).join('  ')}</p>
          )}
        </a>
      </li>
    ))
  }
</ul>

{posts.length === 0 && <p class="empty">아직 글이 없습니다.</p>}

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list > li + li {
    margin-top: var(--space-2);
  }

  .card {
    display: block;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
  }

  .card:hover {
    background: var(--bg-subtle);
  }

  time {
    color: var(--fg-faint);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  h2 {
    font-size: var(--text-base);
    font-weight: 600;
    margin: var(--space-1) 0 var(--space-2);
    line-height: var(--leading-tight);
  }

  p {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  .tags {
    margin-top: var(--space-2);
    color: var(--fg-faint);
    font-size: var(--text-xs);
  }

  .empty {
    color: var(--fg-faint);
  }
</style>
