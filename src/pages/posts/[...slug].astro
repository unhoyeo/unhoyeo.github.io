---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CodeBlocks from '../../components/CodeBlocks.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPublishedPosts, formatDate, isoDate, hasToc, postCrumbs } from '../../utils';
import { REPO_URL, REPO_BRANCH, POSTS_DIR } from '../../consts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // 목록이 최신순이므로 이전 인덱스가 더 최근 글이다
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);

/*
 * 이 글의 원본 마크다운을 GitHub 웹 편집기에서 연다.
 * filePath는 glob 로더가 채워 주는 저장소 기준 경로다. 혹시 없을 때를 대비해
 * id(= 확장자 뺀 파일명)로도 만들 수 있게 해 둔다.
 */
const filePath = post.filePath ?? `${POSTS_DIR}/${post.id}.md`;
const editUrl = `${REPO_URL}/edit/${REPO_BRANCH}/${filePath}`;
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  crumbs={postCrumbs(post)}
>
  {/* 레이아웃이 본문 열 옆 레일에 꽂는다. 목차가 없는 글이면 슬롯을 아예 넘기지 않는다 */}
  {hasToc(headings) && <TableOfContents slot="toc" headings={headings} />}

  {/*
    헤더는 레이아웃의 1행에 따로 들어간다 — 목차 레일이 2행에서,
    즉 본문 첫 줄 높이에서 시작하도록.
  */}
  <header slot="post-header">
    <h1 id="post-title">{post.data.title}</h1>
    <p class="meta">
      <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
      {post.data.updatedDate && <span>· {formatDate(post.data.updatedDate)} 수정</span>}
      <a class="edit" href={editUrl} rel="noopener" target="_blank">
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="currentColor">
          <path
            d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25c.081-.286.235-.547.445-.758l8.61-8.61Zm1.414 1.06a.25.25 0 0 0-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 0 0 0-.354l-1.086-1.086Zm-.176 4.823L9.812 5.871 4.63 11.052a.25.25 0 0 0-.064.108l-.558 1.953 1.953-.558a.25.25 0 0 0 .108-.064l5.182-5.181Z"
          ></path>
        </svg>
        수정
      </a>
    </p>
    {
      post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((tag) => (
            <li>
              <a href={`/tags/${tag}/`}>#{tag}</a>
            </li>
          ))}
        </ul>
      )
    }
  </header>

  {/*
    레이아웃 때문에 제목이 article 밖(1행)에 있다. 보조기기가 이 article의
    이름을 제목에서 가져가도록 aria-labelledby로 다시 이어준다.
  */}
  <article aria-labelledby="post-title">
    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="다른 글">
    {
      older && (
        <a href={`/posts/${older.id}/`} class="pager__item">
          <span>이전 글</span>
          {older.data.title}
        </a>
      )
    }
    {
      newer && (
        <a href={`/posts/${newer.id}/`} class="pager__item pager__item--next">
          <span>다음 글</span>
          {newer.data.title}
        </a>
      )
    }
  </nav>

  <CodeBlocks />
</Base>

<style>
  /* 상단바가 sticky라 제목이 바짝 붙어 보인다. 위쪽을 넉넉히 띄운다 */
  header {
    padding: var(--space-16) 0 var(--space-8);
  }

  header h1 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    color: var(--fg-faint);
    font-size: var(--text-sm);
  }

  /*
   * 나 말고 다른 사람에게는 보일 이유가 없다. 기본은 숨김이고,
   * BaseHead가 html[data-owner]를 달아 준 브라우저에서만 나타난다(?owner=1).
   */
  .edit {
    display: none;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
    color: var(--fg-faint);
    text-decoration: none;
  }

  :global(html[data-owner]) .edit {
    display: inline-flex;
  }

  .edit:hover {
    color: var(--fg);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    font-size: var(--text-xs);
  }

  .tags a {
    color: var(--fg-faint);
    text-decoration: none;
  }

  .tags a:hover {
    color: var(--fg);
  }

  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: var(--space-12);
  }

  /* 넓은 표는 자기 컨테이너 안에서만 스크롤 */
  .prose :global(table) {
    display: block;
    overflow-x: auto;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .pager__item {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    color: var(--fg);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .pager__item:hover {
    background: var(--bg-hover);
  }

  .pager__item span {
    display: block;
    color: var(--fg-faint);
    font-size: var(--text-xs);
    margin-bottom: var(--space-1);
  }

  .pager__item--next {
    text-align: right;
  }
</style>
