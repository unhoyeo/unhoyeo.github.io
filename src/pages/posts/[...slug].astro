---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CodeBlocks from '../../components/CodeBlocks.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPublishedPosts, formatDate, isoDate, hasToc } from '../../utils';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // 목록이 최신순이므로 이전 인덱스가 더 최근 글이다
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
>
  {/* 레이아웃이 본문 열 옆 레일에 꽂는다. 목차가 없는 글이면 슬롯을 아예 넘기지 않는다 */}
  {hasToc(headings) && <TableOfContents slot="toc" headings={headings} />}

  <article>
    <header>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <span>· {formatDate(post.data.updatedDate)} 수정</span>}
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map((tag) => (
              <li>
                <a href={`/tags/${tag}/`}>#{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>


    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="다른 글">
    {
      older && (
        <a href={`/posts/${older.id}/`} class="pager__item">
          <span>이전 글</span>
          {older.data.title}
        </a>
      )
    }
    {
      newer && (
        <a href={`/posts/${newer.id}/`} class="pager__item pager__item--next">
          <span>다음 글</span>
          {newer.data.title}
        </a>
      )
    }
  </nav>

  <CodeBlocks />
</Base>

<style>
  header {
    padding: var(--space-8) 0 var(--space-8);
  }

  header h1 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    color: var(--fg-faint);
    font-size: var(--text-sm);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    font-size: var(--text-xs);
  }

  .tags a {
    color: var(--fg-faint);
    text-decoration: none;
  }

  .tags a:hover {
    color: var(--fg);
  }

  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: var(--space-12);
  }

  /* 넓은 표는 자기 컨테이너 안에서만 스크롤 */
  .prose :global(table) {
    display: block;
    overflow-x: auto;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .pager__item {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    color: var(--fg);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .pager__item:hover {
    background: var(--bg-hover);
  }

  .pager__item span {
    display: block;
    color: var(--fg-faint);
    font-size: var(--text-xs);
    margin-bottom: var(--space-1);
  }

  .pager__item--next {
    text-align: right;
  }
</style>
