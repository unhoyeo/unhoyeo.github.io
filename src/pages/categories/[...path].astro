---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPostsByCategory, flattenCategories, postsUnder, categoryAncestors } from '../../utils';

/*
 * 트리의 모든 노드마다 페이지를 하나씩 만든다. 경로는 그대로 URL이 된다
 * (한글은 Astro가 인코딩해 `/categories/%EC%8A%A4%ED%94%84%EB%A7%81/`로 나간다).
 */
export const getStaticPaths = (async () => {
  const tree = await getPostsByCategory();
  return flattenCategories(tree).map((node) => ({
    params: { path: node.path },
    props: {
      posts: postsUnder(node),
      childNames: node.children.map((child) => ({ name: child.name, path: child.path })),
    },
  }));
}) satisfies GetStaticPaths;

const { path } = Astro.params;
const { posts, childNames } = Astro.props;

const segments = (path ?? '').split('/');
const ancestors = categoryAncestors(segments);
const name = segments[segments.length - 1];

/*
 * 경로 표시는 글 페이지와 같은 규칙으로 상단바가 그린다.
 * 여기서 label로 경로 문자열을 통째로 넘기면 계층이 사라지고,
 * 본문에 또 그리면 같은 것이 두 군데 나온다.
 * 마지막(현재 주제) 세그먼트는 자기 자신이므로 링크를 걸지 않는다.
 */
const crumbs = ancestors.map((ancestor, i) => ({
  label: segments[i],
  href: i < segments.length - 1 ? `/categories/${ancestor}/` : undefined,
}));
---

<Base title={name} description={`${path} 주제의 글`} crumbs={crumbs}>
  <h1>{name}</h1>
  <p class="count">하위 주제 포함 {posts.length}편</p>

  {
    childNames.length > 0 && (
      <ul class="children">
        {childNames.map((child) => (
          <li>
            <a href={`/categories/${child.path}/`}>{child.name}</a>
          </li>
        ))}
      </ul>
    )
  }

  <PostList posts={posts} />
</Base>

<style>
  h1 {
    margin-top: var(--space-8);
  }

  .count {
    color: var(--fg-faint);
    font-size: var(--text-sm);
  }

  .children {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
  }

  .children a {
    display: block;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .children a:hover {
    background: var(--bg-subtle);
    color: var(--fg);
  }
</style>
